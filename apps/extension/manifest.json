{
  "manifest_version": 3,
  "name": "RVaultPass",
  "version": "0.1.0",
  "description": "Client du service RVaultPass",
  "permissions": ["storage", "activeTab", "scripting", "tabs"],
  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "rvaultpass@local",
      "strict_min_version": "121.0"
    }
  },
  "action": {
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
